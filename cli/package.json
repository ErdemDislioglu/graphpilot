{
  "name": "@graphpilot/cli",
  "version": "0.0.0",
  "private": true,
  "description": "GraphPilot `gp` CLI — graph üzerindeki deterministik işler (Faz 2'de tam kurulum).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gp": "tsx src/bin.ts",
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "eslint": "^9.14.0",
    "typescript-eslint": "^8.13.0",
    "prettier": "^3.3.0",
    "@vitest/coverage-v8": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "gray-matter": "^4.0.3",
    "yaml": "^2.5.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2"
  },
  "bin": {
    "gp": "./dist/bin.js"
  }
}
